{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Prague",
  "schedule": [
    "* 6-22 * * 6"
  ],
  "prConcurrentLimit": 5,
  "argocd": {
    "managerFilePatterns": [
      "/^argocd/.+\\.yaml$/",
      "/^bootstrap/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group patch updates of charts and images into one weekly PR",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "weekly patch updates",
      "matchPackageNames": [
        "!k3s-io/k3s"
      ]
    },
    {
      "description": "Major bumps always get their own PR (read the release notes!)",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Postgres+VectorChord image: update by hand (major = pg_upgrade/dump-restore; check Immich's supported VectorChord range first)",
      "matchPackageNames": [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "enabled": false
    },
    {
      "description": "Papra publishes -root and -rootless variants; stay on rootless",
      "matchPackageNames": [
        "ghcr.io/papra-hq/papra"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-rootless$"
    },
    {
      "matchPackageNames": [
        "louislam/uptime-kuma"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-rootless$"
    },
    {
      "description": "k3s: own PR, one minor at a time; merging does nothing until the script runs on the Pi",
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "separateMultipleMinor": true,
      "prBodyNotes": [
        "After merging: copy `host/03-install-k3s.sh` to the Pi and run it with sudo (it takes an etcd snapshot, then upgrades)."
      ]
    },
    {
      "description": "The website image tag is set by CI (.github/workflows/web.yml), not Renovate",
      "matchPackageNames": [
        "ghcr.io/jersyj/lichnovsky-web"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s version: the host install script and the second-Pi join command",
      "managerFilePatterns": [
        "/^host/03-install-k3s\\.sh$/",
        "/^docs/operations\\.md$/"
      ],
      "matchStrings": [
        "K3S_VERSION=\"?(?<currentValue>v[0-9][^\\s\"]*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ]
}
