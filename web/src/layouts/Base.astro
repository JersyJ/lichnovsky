---
interface Props { title?: string; description?: string }
const {
  title = "lichnovsky.eu",
  description = "Self-hosted services of lichnovsky.eu",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --bg: #fafafa;
    --surface: #ffffff;
    --icon-bg: #f4f4f5;
    --text: #18181b;
    --muted: #52525b;
    --faint: #a1a1aa;
    --border: #e4e4e7;
    --border-strong: #d4d4d8;
    --shadow: rgb(0 0 0 / 0.25);
    --accent: #2563eb;
    --up: #16a34a;
    --down: #dc2626;
    --wait: #d97706;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #09090b;
      --surface: #111113;
      --icon-bg: #1c1c1f;
      --text: #fafafa;
      --muted: #a1a1aa;
      --faint: #71717a;
      --border: #232326;
      --border-strong: #3f3f46;
      --shadow: rgb(0 0 0 / 0.8);
      --accent: #60a5fa;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }

  /* Status dots: data-state is set by the status script (up | down | wait). */
  .dot {
    display: inline-block;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--faint);
  }
  .dot[data-state="up"] { background: var(--up); box-shadow: 0 0 0 3px color-mix(in srgb, var(--up) 18%, transparent); }
  .dot[data-state="down"] { background: var(--down); box-shadow: 0 0 0 3px color-mix(in srgb, var(--down) 18%, transparent); }
  .dot[data-state="wait"] { background: var(--wait); }
</style>
