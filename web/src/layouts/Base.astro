---
import "@fontsource-variable/overpass/wght.css";
import "@fontsource/overpass-mono/latin-400.css";

interface Props { title?: string; description?: string }
const {
  title = "lichnovsky.eu",
  description = "Dominik Lichnovsky, DevOps / Platform engineer. A network map of the services behind lichnovsky.eu with the live status",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1330" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* The map's colours. Lines are flat transit colours; green, red and amber belong to status only.
     Light and dark follow the system; dark is the night service: same lines on a navy ground. */
  :root {
    --sans: "Overpass Variable", ui-sans-serif, system-ui, sans-serif;
    --mono: "Overpass Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ground: #ffffff;
    --ink: #0b1b4d;
    --ink-soft: #3d4a73;
    --ink-faint: #69739a;
    --rule: #dde1ec;
    --tunnel: #ee7c0e;
    --tunnel-text: #b35600;
    --home: #a45a00;
    --tailscale: #0098d4;
    --tailscale-text: #0077a8;
    --apps: #9b0056;
    --admin: #9aa3ab;
    --admin-text: #5f6972;
    --up: #10a14d;
    --down: #dc241f;
    --wait: #e0a100;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0b1330;
      --ink: #eef1fa;
      --ink-soft: #b7bfd9;
      --ink-faint: #8891b3;
      --rule: #232d57;
      --tunnel: #f5923a;
      --tunnel-text: #f7a660;
      --home: #c98a3e;
      --tailscale: #2fb3e8;
      --tailscale-text: #5cc6ef;
      --apps: #d1377f;
      --admin: #7c8791;
      --admin-text: #5f6972;
      --up: #2cc46b;
      --down: #f0524d;
      --wait: #f0b72c;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font: 16px/1.5 var(--sans);
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 2px; }
  ::selection { background: var(--ink); color: var(--ground); }
  html { scrollbar-color: var(--ink-faint) var(--ground); }
</style>
