---
interface Props { title?: string }
const { title = "lichnovsky.eu" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark;
          --ok: #16a34a; --down: #dc2626; --wait: #d97706; --muted: #6b7280; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center;
         font: 16px/1.5 system-ui, sans-serif; }
  main { width: min(34rem, 100% - 2rem); padding: 2rem 0; }
  h1 { font-size: 2rem; margin: 0 0 .25rem; text-align: center; }
  .lead { margin: 0 0 2rem; text-align: center; color: var(--muted); }
  .card { border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
          border-radius: .75rem; padding: 1rem 1.25rem; }
  .summary { display: flex; align-items: center; gap: .5rem; font-weight: 600; margin-bottom: .75rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: .6rem; padding: .45rem 0;
       border-top: 1px solid color-mix(in srgb, currentColor 8%, transparent); }
  .dot { width: .7rem; height: .7rem; border-radius: 50%; background: var(--muted); flex: none; }
  .dot.up { background: var(--ok); } .dot.down { background: var(--down); } .dot.wait { background: var(--wait); }
  .name { flex: 1; } .uptime { color: var(--muted); font-variant-numeric: tabular-nums; font-size: .9rem; }
  footer { margin-top: .75rem; font-size: .85rem; color: var(--muted); text-align: center; }
  a { color: inherit; }
</style>
