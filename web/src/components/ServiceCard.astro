---
import Icon from "./Icon.astro";
import type { Service } from "../data/services";

interface Props { service: Service }
const { name, description, url, icon, monitor, private: isPrivate } = Astro.props.service;
const host = new URL(url).host;
---
<a class="card" href={url} data-monitor={monitor}>
  <span class="icon"><Icon name={icon} /></span>
  <span class="text">
    <span class="name">
      {name}
      {monitor && <span class="dot" title="Checking…"></span>}
    </span>
    <span class="description">{description}</span>
    <span class="host">
      {host}
      {isPrivate && <span class="badge" title="Only reachable at home and over Tailscale">home · tailscale</span>}
    </span>
  </span>
  <span class="arrow"><Icon name="arrow" size={16} /></span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -12px var(--shadow);
  }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    background: var(--icon-bg);
    color: var(--text);
  }
  .text { display: grid; gap: 0.1rem; min-width: 0; }
  .name { display: flex; align-items: center; gap: 0.45rem; font-weight: 600; }
  .description { color: var(--muted); font-size: 0.925rem; }
  .host {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    color: var(--faint);
    font: 0.78rem/1.4 var(--mono);
  }
  .badge {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 0.7rem/1.4 var(--sans);
    color: var(--muted);
  }
  .arrow {
    margin-left: auto;
    color: var(--faint);
    transition: color 0.15s, transform 0.15s;
  }
  .card:hover .arrow { color: var(--text); transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: reduce) {
    .card, .arrow { transition: none; }
    .card:hover, .card:hover .arrow { transform: none; }
  }
</style>
