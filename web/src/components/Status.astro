---
// Overall status pill, plus the dots on the service cards (matched by data-monitor = the
// monitor's name). Data: the public Uptime Kuma status page "home" via /status-data/, which
// nginx proxies inside the cluster (nginx.conf) and `npm run dev` proxies to status.lichnovsky.eu.
---
<p class="pill" aria-live="polite">
  <span class="dot" id="overall"></span>
  <span id="summary">Checking services…</span>
</p>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.35rem 0.8rem 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>

<script>
  type StatusPage = { publicGroupList: { monitorList: { id: number; name: string }[] }[] };
  type Heartbeats = { heartbeatList: Record<string, { status: number }[]> };

  // Uptime Kuma heartbeat codes: 1 up, 0 down, 2 pending, 3 maintenance.
  const STATE: Record<number, [state: string, label: string]> = {
    1: ["up", "Operational"], 0: ["down", "Down"], 2: ["wait", "Pending"], 3: ["wait", "Maintenance"],
  };

  async function get<T>(url: string): Promise<T> {
    const r = await fetch(url, { cache: "no-store" });
    if (!r.ok) throw new Error(`${url}: ${r.status}`);
    return r.json();
  }

  function mark(dot: Element | null, state: string, label: string) {
    if (!dot) return;
    dot.setAttribute("data-state", state);
    dot.setAttribute("title", label);
  }

  async function refresh() {
    const overall = document.getElementById("overall");
    const summary = document.getElementById("summary")!;
    try {
      const [page, beats] = await Promise.all([
        get<StatusPage>("/status-data/home"),
        get<Heartbeats>("/status-data/heartbeat/home"),
      ]);
      const down: string[] = [];
      for (const m of page.publicGroupList.flatMap((g) => g.monitorList)) {
        const status = beats.heartbeatList[m.id]?.at(-1)?.status;
        const [state, label] = (status !== undefined && STATE[status]) || ["", "No data"];
        if (status === 0) down.push(m.name);
        document.querySelectorAll(`[data-monitor="${CSS.escape(m.name)}"] .dot`)
          .forEach((dot) => mark(dot, state, label));
      }
      mark(overall, down.length ? "down" : "up", "");
      summary.textContent = down.length
        ? `${down.join(", ")} ${down.length === 1 ? "is" : "are"} down`
        : "All systems operational";
    } catch {
      mark(overall, "wait", "");
      summary.textContent = "Status unavailable";
    }
    const updated = document.getElementById("updated");
    if (updated) updated.textContent = `Updated ${new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
  }

  refresh();
  setInterval(refresh, 60_000);
</script>
