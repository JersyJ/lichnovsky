---
// Live status of the public services, from the Uptime Kuma status page "home".
// nginx proxies /status-data/ to Uptime Kuma inside the cluster (nginx.conf); `npm run dev`
// proxies it to status.lichnovsky.eu (astro.config.mjs).
---
<section class="card" aria-live="polite">
  <div class="summary"><span class="dot" id="overall"></span><span id="summary">Checking services…</span></div>
  <ul id="services"></ul>
</section>
<footer><a href="https://status.lichnovsky.eu/status/home">Full status page</a> · <span id="updated"></span></footer>

<script>
  type Beat = { status: number };
  type StatusPage = { publicGroupList: { monitorList: { id: number; name: string }[] }[] };
  type Heartbeats = { heartbeatList: Record<string, Beat[]>; uptimeList: Record<string, number> };

  // Uptime Kuma heartbeat codes: 1 up, 0 down, 2 pending, 3 maintenance.
  const LABEL: Record<number, [string, string]> = {
    1: ["up", "Operational"], 0: ["down", "Down"], 2: ["wait", "Pending"], 3: ["wait", "Maintenance"],
  };
  const $ = (id: string) => document.getElementById(id)!;

  async function get<T>(url: string): Promise<T> {
    const r = await fetch(url, { cache: "no-store" });
    if (!r.ok) throw new Error(`${url}: ${r.status}`);
    return r.json();
  }

  async function refresh() {
    try {
      const [page, beats] = await Promise.all([
        get<StatusPage>("/status-data/home"),
        get<Heartbeats>("/status-data/heartbeat/home"),
      ]);
      let down = 0, total = 0;
      const items = page.publicGroupList.flatMap((g) => g.monitorList).map((m) => {
        const last = beats.heartbeatList[m.id]?.at(-1);
        const [cls, text] = (last && LABEL[last.status]) || ["", "No data"];
        const uptime = beats.uptimeList[`${m.id}_24`];
        total++;
        if (last?.status === 0) down++;

        const li = document.createElement("li");
        const dot = li.appendChild(document.createElement("span"));
        dot.className = `dot ${cls}`;
        dot.title = text;
        const name = li.appendChild(document.createElement("span"));
        name.className = "name";
        name.textContent = m.name;
        const up = li.appendChild(document.createElement("span"));
        up.className = "uptime";
        up.textContent = uptime == null ? text : `${(uptime * 100).toFixed(2)} % (24 h)`;
        return li;
      });
      $("services").replaceChildren(...items);
      $("overall").className = `dot ${down ? "down" : "up"}`;
      $("summary").textContent = down ? `${down} of ${total} services down` : "All systems operational";
    } catch {
      $("overall").className = "dot wait";
      $("summary").textContent = "Status currently unavailable";
    }
    $("updated").textContent = `updated ${new Date().toLocaleTimeString()}`;
  }

  refresh();
  setInterval(refresh, 60_000);
</script>
