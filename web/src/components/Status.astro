---
// The overall status line, plus the dots in the map's stations (matched by data-monitor = the
// monitor's name). Data: the public Uptime Kuma status page "home" via /status-data/, which
// nginx proxies inside the cluster (nginx.conf) and `npm run dev` proxies to status.lichnovsky.eu.
import { statusPage } from "../data/services";
---
<p class="status" aria-live="polite">
  <span class="dot" id="overall" aria-hidden="true"></span>
  <span><a id="summary" href={statusPage}>Checking services…</a><span id="checked"></span></span>
</p>

<style>
  .status {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  #summary { color: var(--ink); font-weight: 600; text-decoration: none; white-space: nowrap; }
  #summary:hover { text-decoration: underline; }
  #checked { margin-left: 0.6rem; color: var(--ink-faint); white-space: nowrap; }
  .dot {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--ink-faint);
    opacity: 0.4;
    transform: translateY(-0.02em);
    transition: background-color 0.4s, opacity 0.4s;
  }
  .dot[data-state] { opacity: 1; }
  .dot[data-state="up"] { background: var(--up); }
  .dot[data-state="down"] { background: var(--down); }
  .dot[data-state="wait"] { background: var(--wait); }
</style>

<script>
  type StatusPage = { publicGroupList: { monitorList: { id: number; name: string }[] }[] };
  type Heartbeats = { heartbeatList: Record<string, { status: number }[]> };

  // Uptime Kuma heartbeat codes: 1 up, 0 down, 2 pending, 3 maintenance.
  const STATE: Record<number, [state: string, label: string]> = {
    1: ["up", "up"], 0: ["down", "down"], 2: ["wait", "pending"], 3: ["wait", "in maintenance"],
  };

  async function get<T>(url: string): Promise<T> {
    const r = await fetch(url, { cache: "no-store" });
    if (!r.ok) throw new Error(`${url}: ${r.status}`);
    return r.json();
  }

  // A station: its ring's dot colours from data-state, its accessible name gains the state.
  function mark(el: Element, state: string, label: string) {
    if (state) el.setAttribute("data-state", state);
    else el.removeAttribute("data-state");
    const base = el.getAttribute("data-label");
    if (base) el.setAttribute("aria-label", label ? `${base}, ${label}` : base);
    el.setAttribute("title", label ? `${base?.split(",")[0]}: ${label}` : "");
  }

  // The platform notice under the key (index.astro), in transit-status wording.
  const NAMES: Record<string, string> = { apps: "Apps", admin: "Admin" };
  function lineNames(ids: Set<string>) {
    const names = [...ids].map((id) => NAMES[id] ?? id);
    return names.length === 1 ? `${names[0]} line` : `${names.join(" and ")} lines`;
  }
  function announce(text: string, alert: boolean) {
    const el = document.getElementById("notice-status");
    if (!el) return;
    el.textContent = text;
    if (alert) el.dataset.alert = "";
    else delete el.dataset.alert;
  }

  async function refresh() {
    const overall = document.getElementById("overall")!;
    const summary = document.getElementById("summary")!;
    try {
      const [page, beats] = await Promise.all([
        get<StatusPage>("/status-data/home"),
        get<Heartbeats>("/status-data/heartbeat/home"),
      ]);
      const down: string[] = [];
      const delays = { down: new Set<string>(), wait: new Set<string>() };
      for (const m of page.publicGroupList.flatMap((g) => g.monitorList)) {
        const status = beats.heartbeatList[m.id]?.at(-1)?.status;
        const [state, label] = (status !== undefined && STATE[status]) || ["", "no data"];
        if (status === 0) down.push(m.name);
        document.querySelectorAll(`[data-monitor="${CSS.escape(m.name)}"]`).forEach((el) => {
          mark(el, state, label);
          const line = el.closest("[data-line]")?.getAttribute("data-line");
          if (line && (state === "down" || state === "wait")) delays[state].add(line);
        });
      }
      overall.setAttribute("data-state", down.length ? "down" : "up");
      summary.textContent = down.length
        ? `${down.join(", ")} ${down.length === 1 ? "is" : "are"} down`
        : "All services running";
      announce(delays.down.size ? `Severe delays on the ${lineNames(delays.down)}.`
        : delays.wait.size ? `Minor delays on the ${lineNames(delays.wait)}.`
        : "Good service on all lines.", delays.down.size > 0);
    } catch {
      overall.setAttribute("data-state", "wait");
      summary.textContent = "Status unavailable right now";
      announce("Service information is unavailable right now.", false);
    }
    const time = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    document.getElementById("checked")!.textContent = `checked ${time}`;
  }

  refresh();
  setInterval(refresh, 60_000);
</script>
